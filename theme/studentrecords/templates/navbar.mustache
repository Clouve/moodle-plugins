{{!

    @template theme_studentrecords/navbar

    Adapted in 2026 from theme_boost/navbar, under the GNU GPL.

    The top bar: the school's logo and name, the main tabs, notifications, messages and the user menu.
    Same as Boost's navbar with the school brand (srbrand). One template serves Moodle 4.5 to 5.3: navbar-light gives
    the phone menu its icon on Bootstrap 4, sr-only and visually-hidden are the same class on Bootstrap 4 and 5, and
    Moodle 5.3's colour mode menu is empty on earlier versions. The tabs stay on core/moremenu, which all four versions
    have, and not on the core/primarymoremenu of Moodle 5.3, so they keep the school's colour.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "https://example.com/logo.png",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "srbrand": {"schoolname": "Example College", "initials": "EC", "logourl": "", "homeurl": "#"},
        "srnote": "No LMS access",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": false
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": false
            }
        ]
    }
}}
<nav class="navbar navbar-light sr-topbar fixed-top navbar-expand" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="sr-only visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        {{#srbrand}}{{> theme_studentrecords/brand }}{{/srbrand}}
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{#srnote}}
                <span class="sr-topbar-note d-none d-md-inline-flex align-self-center me-2">{{srnote}}</span>
            {{/srnote}}
            {{# output.search_box }}
                {{{ output.search_box }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{{ output.edit_switch }}}
            {{# output.colour_mode_menu }}
                {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/ output.colour_mode_menu }}
            {{# output.navbar_plugin_output }}
            {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
