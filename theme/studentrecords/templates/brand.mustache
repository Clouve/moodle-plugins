{{!
    @template theme_studentrecords/brand

    The school's logo (or initials square) and name, linked to the site home.

    Example context (json):
    {
        "schoolname": "Example College",
        "initials": "EC",
        "logourl": "",
        "homeurl": "#"
    }
}}
<a href="{{homeurl}}" class="sr-brand navbar-brand d-flex align-items-center m-0 p-0 aabtn" aria-label="{{#str}}homelink, theme_studentrecords, {{schoolname}}{{/str}}">
    {{#logourl}}<img src="{{logourl}}" class="sr-brand-logo" alt="">{{/logourl}}
    {{^logourl}}<span class="sr-brand-tile" aria-hidden="true">{{initials}}</span>{{/logourl}}
    <span class="sr-brand-name">{{schoolname}}</span>
</a>
