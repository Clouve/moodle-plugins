{{!
    @template theme_studentrecords/loginform

    The login card: the school's logo, name and welcome text, Moodle's own login form, and the help text.
    The form comes from Moodle unchanged. Its own logo and heading are hidden by the theme's styles.

    Context variables required for this template:
    * srbrand - The school's name, initials, logo and home link
    * srwelcome - The welcome text. Without it the card says "Log in to" and the school's name
    * srhelp - The help text
    * form - HTML of Moodle's login form

    Example context (json):
    {
        "srbrand": {"schoolname": "Example College", "initials": "EC", "logourl": "", "homeurl": "#"},
        "srwelcome": "Welcome. One login for your classes, grades, bills and records.",
        "srhelp": "Need help? Call the school office.",
        "form": "<form action=\"#\"><button type=\"submit\">Log in</button></form>"
    }
}}
<div class="sr-login-head text-center mb-4">
    {{#srbrand}}
        {{#logourl}}<img src="{{logourl}}" class="sr-login-logo" alt="">{{/logourl}}
        {{^logourl}}<span class="sr-login-tile" aria-hidden="true">{{initials}}</span>{{/logourl}}
        <h1 class="h2 mt-3 mb-2">{{schoolname}}</h1>
    {{/srbrand}}
    {{#srwelcome}}<p class="sr-login-welcome mb-0">{{srwelcome}}</p>{{/srwelcome}}
    {{^srwelcome}}<p class="sr-login-welcome mb-0">{{#str}} loginto, core, {{srbrand.schoolname}} {{/str}}</p>{{/srwelcome}}
</div>
{{{ form }}}
{{#srhelp}}
    <p class="sr-login-help text-center small border-top pt-3 mb-3">{{srhelp}}</p>
{{/srhelp}}
