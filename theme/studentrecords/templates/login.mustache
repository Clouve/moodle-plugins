{{!
    @template theme_studentrecords/login

    Adapted in 2026 from theme_boost/login, under the GNU GPL.

    Login page: the top bar with the school's name, and one centred card with the login form. Boost scopes the styles
    of its login form to login-container, so the card carries that class too.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Log in",
            "favicon": "favicon.ico",
            "main_content": "<h1>Log in</h1>"
        },
        "bodyattributes": "",
        "srbrand": {"schoolname": "Example College", "initials": "EC", "logourl": "", "homeurl": "#"}
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <header class="sr-topbar sr-topbar-login">
        {{#srbrand}}{{> theme_studentrecords/brand }}{{/srbrand}}
    </header>

    <div id="page" class="sr-login-page">
        <div id="page-content">
            <div id="region-main" class="sr-login-card login-container">
                {{{ output.main_content }}}
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
