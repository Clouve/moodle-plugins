#!/usr/bin/env bash
# Work out what a release tag stands for. See usage() below.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/release-info <tag>

Reads a release tag of the form <component>-v<release> (for example
local_academictranscript-v1.0.0) and prints, one per line:

  path=<plugin folder, relative to the repo root>
  component=<component>
  release=<release>
  zip=<component>-<release>.zip
  notes=<temp file holding the plugin's CHANGES.md section for this release>

The lines work as they are for appending to $GITHUB_OUTPUT. The notes file holds
the section of the plugin's CHANGES.md that starts at the line "## <release>" (a
date or other text may follow the release) and runs up to the next "## " line. It
leaves out the heading line itself, because the release title already says the
release. The caller removes the file.

It fails, printing nothing to stdout, when the tag is not in that form, no plugin
has that component, the release differs from the one in version.php, or
CHANGES.md has no section (or an empty one) for the release.
EOF
}

die() {
  printf 'release-info: %s\n' "$*" >&2
  exit 1
}

# plugin_prop <version.php> <name>: print the quoted value that $plugin-><name> is
# set to in a version.php file (nothing when it is not set).
plugin_prop() {
  local line quotes="'\"" re
  re="^[[:space:]]*[\$]plugin->$2[[:space:]]*=[[:space:]]*[$quotes]([^$quotes]*)[$quotes]"
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ $re ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done <"$1"
}

case ${1:-} in
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    usage >&2
    exit 2
    ;;
esac
if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# GITHUB_REF holds the full name of a tag; GITHUB_REF_NAME holds the short one.
tag=${1#refs/tags/}

# <component>-v<release>. A component never holds a hyphen, a release may, so the
# first "-v" is the split.
bad_tag="\"$tag\" is not a release tag. A tag looks like <component>-v<release>, for example local_academictranscript-v1.0.0"
[[ $tag == *-v* ]] || die "$bad_tag"
component=${tag%%-v*}
release=${tag#"$component"-v}
[[ $component =~ ^[a-z][a-z0-9]*_[a-z][a-z0-9_]*$ ]] || die "$bad_tag"
[[ $release =~ ^[0-9A-Za-z][0-9A-Za-z._+-]*$ ]] || die "$bad_tag"

# Find the plugin folder whose version.php sets that component.
plugin_list=$("$repo/bin/list-plugins")
matches=()
while IFS= read -r dir; do
  if [ -n "$dir" ] && [ "$(plugin_prop "$repo/$dir/version.php" component)" = "$component" ]; then
    matches+=("$dir")
  fi
done <<<"$plugin_list"
[ ${#matches[@]} -gt 0 ] || die "no plugin folder sets the component $component"
[ ${#matches[@]} -eq 1 ] || die "more than one plugin folder sets the component $component: ${matches[*]}"
path=${matches[0]}

declared=$(plugin_prop "$repo/$path/version.php" release)
[ "$declared" = "$release" ] ||
  die "the tag says release $release, but $path/version.php says ${declared:-no release}"

changes=$repo/$path/CHANGES.md
[ -f "$changes" ] || die "$path/CHANGES.md does not exist"

# The section under "## <release>", up to the next "## " heading. The heading may
# carry a date after the release; it is not part of the notes. Carriage returns and
# the blank lines at the start and at the end of the section are dropped. Exit
# codes: 3 no such section, 4 nothing under it.
notes=$(mktemp "${TMPDIR:-/tmp}/release-notes.XXXXXX")
status=0
awk -v release="$release" '
  { sub(/\r$/, "") }
  /^## / {
    if (found) exit
    title = substr($0, 4)
    if (title == release || index(title, release " ") == 1 || index(title, release "\t") == 1) {
      found = 1
      next
    }
  }
  found {
    if ($0 ~ /^[ \t]*$/) { if (body) blanks = blanks "\n"; next }
    printf "%s", blanks
    blanks = ""
    body = 1
    print
  }
  END {
    if (!found) exit 3
    if (!body) exit 4
  }
' "$changes" >"$notes" || status=$?
case $status in
  0) ;;
  3)
    rm -f "$notes"
    die "$path/CHANGES.md has no section that starts with \"## $release\""
    ;;
  4)
    rm -f "$notes"
    die "the \"## $release\" section of $path/CHANGES.md is empty"
    ;;
  *)
    rm -f "$notes"
    die "could not read $path/CHANGES.md"
    ;;
esac

printf 'path=%s\n' "$path"
printf 'component=%s\n' "$component"
printf 'release=%s\n' "$release"
printf 'zip=%s-%s.zip\n' "$component" "$release"
printf 'notes=%s\n' "$notes"
